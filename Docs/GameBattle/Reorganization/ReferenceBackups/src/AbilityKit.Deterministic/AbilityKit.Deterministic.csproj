<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AbilityKit.Deterministic</RootNamespace>
    <AssemblyName>AbilityKit.Deterministic</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/DeterministicHash.cs;../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/DeterministicMath.cs;../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/DeterministicRandom.cs;../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/Fixed64.cs;../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/FixedVec2.cs;../../Unity/Assets/Scripts/GameBattle/Foundation/Math/Deterministic/FixedVec3.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all"/>
    <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
    <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
  </ItemGroup>
</Project>