# Test artifact roots (gate runner output, headless snapshots, dotnet TRX,
# Unity Library, per-project build artifacts). The historical archive under
# artifacts/headless-archive/ is also ignored — its documentation lives in
# .claude/skills/test-artifacts/ instead, so the archive itself needs no README.
**/artifacts/
**/TestResults/

tools/feishu-design-sync.local.json

.vs/

sample-web/
sample-output/

# Local-only workspace for iterative drafts and generated material.
/local/

# Stray test-result / layout-batch XML dumped into Unity/ by ad-hoc runs,
# and editor logs. (Real gate output goes under artifacts/ which is ignored above.)
/Unity/*-results.xml
/Unity/*-final-results.xml
/Unity/*-batch.xml
/Unity/*-next-batch.xml
/Logs/

# Ad-hoc Unity diagnostics, not project configuration or regression fixtures.
/Unity/build_errors*.log
/Unity/unit_test_build_errors*.log
/Unity/msbuild_errors.txt
/Unity/error_json.json

